{
  "name": "SKYBOUND",
  "release": "2026-10-26",
  "hosting": "GitHub Pages",
  "entrypoint": "/",
  "mode": "static",
  "featuresRequiringBackend": [
    "accounts",
    "multiplayer",
    "chat"
  ],
  "touchControls": {
    "toggle": true,
    "mobileDefault": "enabled",
    "desktopDefault": "disabled",
    "savedPreference": true
  },
  "revision": "sky-weather-and-reflections",
  "engineAudio": {
    "type": "procedural",
    "kinds": [
      "prop",
      "jet"
    ],
    "volumeControl": true,
    "muteControl": true
  },
  "newLivery": {
    "aircraft": "b757",
    "id": "icelandair",
    "registration": "TF-FIZ"
  },
  "lighting": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "effects": [
      "AO",
      "Bloom",
      "AgX",
      "SMAA"
    ],
    "quality": "high",
    "toggle": true
  },
  "atmosphere": {
    "sharedSolarTime": true,
    "weatherPresets": [
      "clear",
      "scattered",
      "wind"
    ],
    "clouds": {
      "high": 50,
      "low": 9,
      "type": "noise-shaded cumulus billboards",
      "liveWeather": false
    },
    "skyReflections": {
      "high": 256,
      "low": 64
    },
    "realTerrainDetail": true,
    "hdrWhenSupported": true,
    "subtleBloom": true
  }
}
